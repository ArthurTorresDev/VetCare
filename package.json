{
  "name": "vetcare",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@vetcare/api",
    "dev:web": "npm run dev --workspace=@vetcare/web",
    "start": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run start:api\" \"npm run start:web\"",
    "start:api": "npx tsx apps/api/src/server.ts",
    "start:web": "npm run start --workspace=@vetcare/web",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "ci": "npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.20.5",
    "concurrently": "^9.2.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.2",
    "tsup": "^9.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
