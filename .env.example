# Core
NODE_ENV=development
PORT=3000

# App
NEXT_PUBLIC_APP_NAME=VetCare
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# API
API_BASE_URL=http://localhost:4000
API_PORT=4000

# Database (exemplo de conexão para PostgreSQL quando ativado)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vetcare

# Segurança e Autenticação (JWT & Hashing)
JWT_SECRET=vetcare-dev-super-secret-jwt-key-min32chars-2026
JWT_EXPIRES_IN=2h
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Calendar API Integration
# Em desenvolvimento local, o sistema opera automaticamente no modo simulado (Mock).
# Para conectar à API oficial do Google Agenda em produção:
# 1. Ative a Google Calendar API no Google Cloud Console
# 2. Insira o ID da agenda da clínica e o Access Token / Service Account
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ACCESS_TOKEN=
